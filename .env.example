# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
MONGO_URI=mongodb://127.0.0.1:27017/facturacion

# Sesiones del panel — generar con: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=8h

# Origenes permitidos para el panel (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Servicio externo de Firma Digital (HSM Sign CR), usado solo para verificar si la
# identificación del tenant existe con un certificado vigente -- nunca se firma ni se maneja
# el PIN de nadie. Vacío = se usa la URL pública de la guía como valor por defecto.
HSM_SIGN_CR_URL=https://hsm-sign-cr.onrender.com
